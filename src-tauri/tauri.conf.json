{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cc-terminal-sessions",
  "version": "0.2.0",
  "identifier": "dk.knak-nielsen.cc-terminal-sessions",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "cc-terminal-sessions",
        "width": 400,
        "height": 200,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
